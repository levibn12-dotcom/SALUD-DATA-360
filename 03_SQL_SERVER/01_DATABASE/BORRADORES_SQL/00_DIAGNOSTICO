   00_diagnostico_previo.sql
   Proyecto : Salud Data 360 - DIRESA La Libertad (tamizajes de salud mental)
   Proposito: SOLO LECTURA. Muestra que existe realmente en la base antes
              de ejecutar los scripts 01 a 05. No modifica nada.
   Ejecutar : primero, en SQL Server Management Studio.
   ===================================================================== */
USE BD_DataSalud_LaLibertad;
GO

-- 1. Objetos esperados por el script original (BIG DATA.sql) y estado
SELECT objeto, existe =
       CASE WHEN OBJECT_ID(objeto) IS NULL THEN 'NO EXISTE' ELSE 'existe' END
FROM (VALUES
    (N'dbo.[DAT SALUD MENTAL - TAMIZAJE]'),   -- tabla que crea el asistente de importacion
    (N'dbo.tbl_tamizajes_salud_mental_limpio'),
    (N'dbo.usp_procesar_tamizajes_salud_mental'),
    (N'dbo.Dim_Ubicacion'), (N'dbo.Dim_Tiempo'), (N'dbo.Dim_Perfil'), (N'dbo.Fact_Tamizajes'),
    (N'dbo.staging_atenciones_mental'), (N'dbo.tbl_atenciones_salud_mental'),
    (N'dbo.tbl_cuarentena_atenciones')
) AS t(objeto);
GO

-- 2. Filas actuales en las tablas principales (0 = vacia o inexistente)
SELECT 'tabla limpia' AS tabla,
       CASE WHEN OBJECT_ID(N'dbo.tbl_tamizajes_salud_mental_limpio') IS NULL THEN NULL
            ELSE (SELECT COUNT(*) FROM dbo.tbl_tamizajes_salud_mental_limpio) END AS filas
UNION ALL
SELECT 'Fact_Tamizajes (antiguo)',
       CASE WHEN OBJECT_ID(N'dbo.Fact_Tamizajes') IS NULL THEN NULL
            ELSE (SELECT COUNT(*) FROM dbo.Fact_Tamizajes) END;
GO

-- 3. Tipo con que el asistente cargo 'ubigeo' (debe ser texto; si es int se perdio el cero inicial)
SELECT c.name AS columna, ty.name AS tipo, c.max_length
FROM sys.columns c
JOIN sys.types   ty ON ty.user_type_id = c.user_type_id
WHERE c.object_id = OBJECT_ID(N'dbo.[DAT SALUD MENTAL - TAMIZAJE]')
ORDER BY c.column_id;
GO

-- 4. Reglas que el diagnostico del CSV espera ver (valores del archivo original)
--    Filas esperadas en el CSV: 236,527 | suma de Casos esperada: 2,148,956
IF OBJECT_ID(N'dbo.[DAT SALUD MENTAL - TAMIZAJE]') IS NOT NULL
    EXEC(N'SELECT COUNT(*) AS filas, SUM(CAST(Casos AS BIGINT)) AS suma_casos,
                  COUNT(DISTINCT ubigeo) AS ubigeos
           FROM dbo.[DAT SALUD MENTAL - TAMIZAJE];');
GO
