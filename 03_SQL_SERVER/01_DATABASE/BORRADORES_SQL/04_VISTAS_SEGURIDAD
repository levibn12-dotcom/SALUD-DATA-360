USE BD_DataSalud_LaLibertad;
GO

-- ---------------------------------------------------------------------
-- 1. Vistas analiticas (cada medida por separado: TOTAL, POSITIVO, VIOLENCIA_POLITICA)
-- ---------------------------------------------------------------------
CREATE OR ALTER VIEW dbo.vw_tamizajes_base AS
SELECT l.id_tamizaje, l.anio, l.nro_mes, l.ubigeo, l.departamento, l.provincia, l.distrito,
       l.sexo, l.etapa, l.orden_etapa, l.grupo_tamizaje, l.detalle_tamizaje,
       CASE l.grupo_tamizaje
            WHEN 'TOTAL DE TAMIZAJES' THEN 'TOTAL'
            WHEN 'SOLO TAMIZAJES POSITIVOS' THEN 'POSITIVO'
            WHEN 'TAMIZAJES C/CONDICION ADICIONAL VIOLENCIA POLITICA' THEN 'VIOLENCIA_POLITICA'
            ELSE 'OTRO' END AS tipo_medida,
       l.casos, l.bandera_positivos_gt_total
FROM dbo.tbl_tamizajes_salud_mental_limpio l;
GO

-- Total de tamizajes por provincia y etapa de vida, SIN mezclar tipos de medida
CREATE OR ALTER VIEW dbo.vw_tamizajes_por_provincia AS
SELECT departamento, provincia, etapa, orden_etapa, tipo_medida,
       SUM(CAST(casos AS BIGINT)) AS TotalCasos
FROM dbo.vw_tamizajes_base
WHERE provincia IS NOT NULL AND provincia <> ''
GROUP BY departamento, provincia, etapa, orden_etapa, tipo_medida;
GO

-- Tendencia mensual por tipo de medida; es_mes_parcial avisa que el mes no esta completo
CREATE OR ALTER VIEW dbo.vw_tamizajes_tendencia_temporal AS
SELECT t.anio, t.nro_mes, t.nombre_mes, t.es_mes_parcial, z.tipo_medida,
       SUM(CAST(f.casos AS BIGINT)) AS TotalCasosMensuales
FROM dw.Fact_Tamizajes f
JOIN dw.Dim_Tiempo   t ON t.sk_tiempo   = f.sk_tiempo
JOIN dw.Dim_Tamizaje z ON z.sk_tamizaje = f.sk_tamizaje
GROUP BY t.anio, t.nro_mes, t.nombre_mes, t.es_mes_parcial, z.tipo_medida;
GO

-- Indicador: porcentaje de positivos sobre el total, solo para los trastornos que tienen ambos
CREATE OR ALTER VIEW dbo.vw_indicador_positividad AS
SELECT departamento, provincia, detalle_tamizaje,
       SUM(CASE WHEN tipo_medida = 'TOTAL'    THEN CAST(casos AS BIGINT) ELSE 0 END) AS tamizajes_total,
       SUM(CASE WHEN tipo_medida = 'POSITIVO' THEN CAST(casos AS BIGINT) ELSE 0 END) AS tamizajes_positivos,
       CAST(100.0 * SUM(CASE WHEN tipo_medida = 'POSITIVO' THEN CAST(casos AS BIGINT) ELSE 0 END)
            / NULLIF(SUM(CASE WHEN tipo_medida = 'TOTAL' THEN CAST(casos AS BIGINT) ELSE 0 END), 0)
            AS DECIMAL(7, 2)) AS porcentaje_positivos
FROM dbo.vw_tamizajes_base
WHERE tipo_medida IN ('TOTAL', 'POSITIVO')
  AND detalle_tamizaje IN ('SINDROME Y/O TRASTORNO PSICOTICO', 'TRASTORNO DEPRESIVO',
                           'VIOLENCIA FAMILIAR/MALTRATO INFANTIL')
GROUP BY departamento, provincia, detalle_tamizaje;
GO

-- Solo DIRESA La Libertad (ubigeo con prefijo 13)
CREATE OR ALTER VIEW dbo.vw_tamizajes_la_libertad AS
SELECT * FROM dbo.vw_tamizajes_base WHERE departamento = 'LA LIBERTAD';
GO

-- ---------------------------------------------------------------------
-- 2. Auditoria e integridad (triggers)
-- ---------------------------------------------------------------------
IF OBJECT_ID(N'dbo.tbl_auditoria_tamizajes', N'U') IS NULL
CREATE TABLE dbo.tbl_auditoria_tamizajes (
    id_auditoria  INT IDENTITY(1,1) CONSTRAINT PK_auditoria_tamizajes PRIMARY KEY,
    operacion     CHAR(1)      NOT NULL,   -- U = actualizacion, D = eliminacion
    id_tamizaje   INT          NOT NULL,
    casos_antes   INT          NULL,
    casos_despues INT          NULL,
    usuario       SYSNAME      NOT NULL,
    equipo        NVARCHAR(128) NULL,
    fecha         DATETIME2(0) NOT NULL CONSTRAINT DF_auditoria_fecha DEFAULT SYSDATETIME()
);
GO

-- Auditoria: registra quien modifica o borra filas depuradas
CREATE OR ALTER TRIGGER dbo.trg_aud_tamizajes_limpio
ON dbo.tbl_tamizajes_salud_mental_limpio
AFTER UPDATE, DELETE
AS
BEGIN
    SET NOCOUNT ON;
    INSERT INTO dbo.tbl_auditoria_tamizajes
        (operacion, id_tamizaje, casos_antes, casos_despues, usuario, equipo)
    SELECT CASE WHEN i.id_tamizaje IS NULL THEN 'D' ELSE 'U' END,
           d.id_tamizaje, d.casos, i.casos, SUSER_SNAME(), HOST_NAME()
    FROM deleted d
    LEFT JOIN inserted i ON i.id_tamizaje = d.id_tamizaje;
END;
GO

-- Integridad: rechaza filas invalidas aunque la tabla no tenga CHECK
-- (la tabla puede no tenerlos si ya traia filas de la carga antigua)
CREATE OR ALTER TRIGGER dbo.trg_integridad_tamizajes_limpio
ON dbo.tbl_tamizajes_salud_mental_limpio
AFTER INSERT, UPDATE
AS
BEGIN
    SET NOCOUNT ON;
    IF EXISTS (SELECT 1 FROM inserted
               WHERE casos IS NULL OR casos < 1
                  OR nro_mes NOT BETWEEN 1 AND 12
                  OR dbo.fn_ubigeo_valido(ubigeo) = 0)
    BEGIN
        ROLLBACK TRANSACTION;
        THROW 50020, 'Fila rechazada: casos debe ser >= 1, mes entre 1 y 12 y ubigeo de 6 digitos.', 1;
    END
END;
GO

