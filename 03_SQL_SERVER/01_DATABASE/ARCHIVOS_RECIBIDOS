-- ==========================================================
-- VISTA 1: Total de Tamizajes por Provincia y Etapa de Vida
-- ==========================================================
CREATE OR ALTER VIEW vw_tamizajes_por_provincia AS
SELECT 
    Provincia,
    Etapa,
    SUM(Casos) AS TotalCasos
FROM tbl_tamizajes_salud_mental_limpio
WHERE Provincia IS NOT NULL AND Provincia <> ''
GROUP BY Provincia, Etapa;
GO

-- ==========================================================
-- VISTA 2: Tendencia de Casos por Año y Mes
-- ==========================================================
CREATE OR ALTER VIEW vw_tamizajes_tendencia_temporal AS
SELECT 
    anio,
    nro_mes,
    SUM(Casos) AS TotalCasosMensuales
FROM tbl_tamizajes_salud_mental_limpio
GROUP BY anio, nro_mes;
GO

