-- 1. Crear o ajustar la tabla final limpia para Tamizajes si aún no la tienes
CREATE TABLE tbl_tamizajes_salud_mental_limpio (
    id_tamizaje INT IDENTITY(1,1) PRIMARY KEY,
    anio SMALLINT,
    nro_mes TINYINT,
    ubigeo VARCHAR(10),
    departamento VARCHAR(50),
    provincia VARCHAR(50),
    distrito VARCHAR(50),
    sexo VARCHAR(50),
    etapa VARCHAR(50),
    grupo_tamizaje VARCHAR(50),
    detalle_tamizaje VARCHAR(50),
    casos INT,
    fecha_carga DATETIME DEFAULT GETDATE()
);
GO

-- 2. Procedimiento de Ingesta y Validación para Tamizajes
CREATE OR ALTER PROCEDURE usp_procesar_tamizajes_salud_mental
AS
BEGIN
    DECLARE @error_msg VARCHAR(255);
    
    BEGIN TRANSACTION;
    
    BEGIN TRY
        SAVE TRANSACTION SP_ProcesoTamizajes;

        -- Insertar registros limpios y válidos a la tabla final
        INSERT INTO tbl_tamizajes_salud_mental_limpio (
            anio, nro_mes, ubigeo, departamento, provincia, distrito, 
            sexo, etapa, grupo_tamizaje, detalle_tamizaje, casos
        )
        SELECT 
            Anio,
            NroMes,
            ubigeo,
            Departamento,
            Provincia,
            Distrito,
            Sexo,
            Etapa,
            GrupoTamizaje,
            DetalleTamizaje,
            Casos
        FROM dbo.[DAT SALUD MENTAL - TAMIZAJE]
        WHERE Anio IS NOT NULL 
          AND Casos IS NOT NULL 
          AND Casos >= 0;

        COMMIT TRANSACTION;
        PRINT 'Procesamiento y limpieza de tamizajes ejecutado con éxito.';

    END TRY
    BEGIN CATCH
        ROLLBACK TRANSACTION SP_ProcesoTamizajes;
        COMMIT TRANSACTION;
        
        SET @error_msg = ERROR_MESSAGE();
        PRINT 'Error en el procesamiento. Rollback aplicado. Detalle: ' + @error_msg;
    END CATCH;
END;
GO




