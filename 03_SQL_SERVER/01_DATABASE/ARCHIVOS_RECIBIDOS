-- 2. Tabla Staging (Recibe el CSV crudo tal cual, con tipos de datos texto para evitar errores de carga)
CREATE TABLE staging_atenciones_mental (
    id_staging INT IDENTITY(1,1) PRIMARY KEY,
    Co_Establecimiento VARCHAR(50),
    Nom_Establecimiento VARCHAR(255),
    Fecha_Atencion VARCHAR(50),
    Edad VARCHAR(50),
    Sexo VARCHAR(10),
    Diagnostico VARCHAR(100),
    Ubigeo VARCHAR(10)
);
GO

-- 3. Tabla Final Limpia (Ya estructurada con tipos de datos correctos y restricciones)
CREATE TABLE tbl_atenciones_salud_mental (
    id_atencion INT IDENTITY(1,1) PRIMARY KEY,
    co_establecimiento VARCHAR(50) NOT NULL,
    nom_establecimiento VARCHAR(255),
    fecha_atencion DATE NOT NULL,
    edad INT CHECK (edad >= 0 AND edad <= 120),
    sexo CHAR(1),
    diagnostico VARCHAR(100) NOT NULL,
    ubigeo VARCHAR(10),
    fecha_carga DATETIME DEFAULT GETDATE()
);
GO

-- 4. Tabla de Cuarentena (Para almacenar registros rechazados por reglas de calidad)
CREATE TABLE tbl_cuarentena_atenciones (
    id_cuarentena INT IDENTITY(1,1) PRIMARY KEY,
    co_establecimiento VARCHAR(50),
    fecha_atencion VARCHAR(50),
    edad VARCHAR(50),
    diagnostico VARCHAR(100),
    motivo_error VARCHAR(255),
    fecha_rechazo DATETIME DEFAULT GETDATE()
);
GO






