CREATE OR ALTER PROCEDURE usp_ingesta_y_validar_atenciones
    @lote_id VARCHAR(50)
AS
BEGIN
    -- Declarar la variable de errores correctamente aquí arriba
    DECLARE @error_msg VARCHAR(255);
    
    -- Iniciar transacción general
    BEGIN TRANSACTION;
    
    BEGIN TRY
        -- 1. SALVAR PUNTO ANTES DE PROCESAR
        SAVE TRANSACTION SP_InicioIngesta;

        -- 2. Enviar a Cuarentena los registros con campos críticos nulos o vacíos
        INSERT INTO tbl_cuarentena_atenciones (co_establecimiento, fecha_atencion, edad, diagnostico, motivo_error)
        SELECT 
            Co_Establecimiento, 
            Fecha_Atencion, 
            Edad, 
            Diagnostico, 
            'Campos criticos nulos o vacios' AS motivo_error
        FROM staging_atenciones_mental
        WHERE Diagnostico IS NULL 
           OR Diagnostico = '' 
           OR Fecha_Atencion IS NULL 
           OR Fecha_Atencion = '';

        -- 3. Insertar a la Tabla Final los registros limpios y válidos
        INSERT INTO tbl_atenciones_salud_mental (co_establecimiento, nom_establecimiento, fecha_atencion, edad, sexo, diagnostico, ubigeo)
        SELECT 
            Co_Establecimiento,
            Nom_Establecimiento,
            TRY_CAST(Fecha_Atencion AS DATE),
            TRY_CAST(Edad AS INT),
            Sexo,
            Diagnostico,
            Ubigeo
        FROM staging_atenciones_mental
        WHERE Diagnostico IS NOT NULL 
          AND Diagnostico != ''
          AND Fecha_Atencion IS NOT NULL 
          AND Fecha_Atencion != ''
          AND TRY_CAST(Edad AS INT) BETWEEN 0 AND 120;

        -- Confirmar transacción si todo sale bien
        COMMIT TRANSACTION;
        PRINT 'Ingesta y validacion ejecutada correctamente de forma transaccional.';

    END TRY
    BEGIN CATCH
        -- Si ocurre un error, hacer rollback al punto de salvado
        ROLLBACK TRANSACTION SP_InicioIngesta;
        COMMIT TRANSACTION; 
        
        SET @error_msg = ERROR_MESSAGE();
        PRINT 'Error detectado durante la ingesta. Se aplico rollback parcial. Detalle: ' + @error_msg;
    END CATCH;
END;
GO

