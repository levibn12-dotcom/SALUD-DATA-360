-- ==========================================================
-- 1. CREACIÓN DE TABLAS DE DIMENSIÓN (Kimball)
-- ==========================================================

-- Dimensión Ubicación
CREATE TABLE Dim_Ubicacion (
    id_ubicacion INT IDENTITY(1,1) PRIMARY KEY,
    ubigeo VARCHAR(10),
    departamento VARCHAR(50),
    provincia VARCHAR(50),
    distrito VARCHAR(50)
);
GO

-- Dimensión Tiempo
CREATE TABLE Dim_Tiempo (
    id_tiempo INT IDENTITY(1,1) PRIMARY KEY,
    anio SMALLINT,
    nro_mes TINYINT
);
GO

-- Dimensión Perfil / Grupo Tamizaje
CREATE TABLE Dim_Perfil (
    id_perfil INT IDENTITY(1,1) PRIMARY KEY,
    sexo VARCHAR(50),
    etapa VARCHAR(50),
    grupo_tamizaje VARCHAR(50),
    detalle_tamizaje VARCHAR(50)
);
GO

-- ==========================================================
-- 2. CREACIÓN DE LA TABLA DE HECHOS (Fact Table)
-- ==========================================================
CREATE TABLE Fact_Tamizajes (
    id_fact INT IDENTITY(1,1) PRIMARY KEY,
    id_ubicacion INT FOREIGN KEY REFERENCES Dim_Ubicacion(id_ubicacion),
    id_tiempo INT FOREIGN KEY REFERENCES Dim_Tiempo(id_tiempo),
    id_perfil INT FOREIGN KEY REFERENCES Dim_Perfil(id_perfil),
    casos INT
);
GO

