-- 1. Poblar Dimensión Ubicación
INSERT INTO Dim_Ubicacion (ubigeo, departamento, provincia, distrito)
SELECT DISTINCT ubigeo, departamento, provincia, distrito
FROM tbl_tamizajes_salud_mental_limpio
WHERE provincia IS NOT NULL;
GO

-- 2. Poblar Dimensión Tiempo
INSERT INTO Dim_Tiempo (anio, nro_mes)
SELECT DISTINCT anio, nro_mes
FROM tbl_tamizajes_salud_mental_limpio
WHERE anio IS NOT NULL AND nro_mes IS NOT NULL;
GO

-- 3. Poblar Dimensión Perfil
INSERT INTO Dim_Perfil (sexo, etapa, grupo_tamizaje, detalle_tamizaje)
SELECT DISTINCT sexo, etapa, grupo_tamizaje, detalle_tamizaje
FROM tbl_tamizajes_salud_mental_limpio;
GO

-- 4. Poblar la Tabla de Hechos (Fact_Tamizajes) relacionando las dimensiones
INSERT INTO Fact_Tamizajes (id_ubicacion, id_tiempo, id_perfil, casos)
SELECT 
    u.id_ubicacion,
    t.id_tiempo,
    p.id_perfil,
    l.casos
FROM tbl_tamizajes_salud_mental_limpio l
INNER JOIN Dim_Ubicacion u ON l.ubigeo = u.ubigeo AND l.provincia = u.provincia
INNER JOIN Dim_Tiempo t ON l.anio = t.anio AND l.nro_mes = t.nro_mes
INNER JOIN Dim_Perfil p ON l.sexo = p.sexo AND l.etapa = p.etapa AND l.grupo_tamizaje = p.grupo_tamizaje AND l.detalle_tamizaje = p.detalle_tamizaje;
GO

